@startuml
left to right direction
skinparam usecase {
  BackgroundColor LightSkyBlue
}
actor Seller
actor SystemAdmin
actor CustomerService

package "客户关系管理系统" {
  usecase "买家 VIP 与折扣优惠管理" as vipManagement
  usecase "查看客户 VIP 等级" as viewVipLevel
  usecase "设置折扣规则" as setDiscountRules
  usecase "发放优惠券" as issueCoupons
  usecase "查看优惠使用情况" as viewCouponUsage
  
  usecase "查询交易历史" as viewTransactionHistory
  usecase "查看客户资料" as viewCustomerInfo
  usecase "计算客单价" as calculateAverageOrderValue
  usecase "添加标签" as addTags
  usecase "添加备注" as addNotes
}

' 参与者与主用例关联
Seller --> vipManagement
SystemAdmin --> vipManagement
Seller --> viewTransactionHistory
CustomerService --> viewTransactionHistory

' 主用例与其子用例关联（使用extends关系更合适）
vipManagement <.. viewVipLevel : <<extends>>
vipManagement <.. setDiscountRules : <<extends>>
vipManagement <.. issueCoupons : <<extends>>
vipManagement <.. viewCouponUsage : <<extends>>

' 查询交易历史的扩展功能（使用extends关系）
viewTransactionHistory <.. viewCustomerInfo : <<extends>>
viewTransactionHistory <.. calculateAverageOrderValue : <<extends>>
viewTransactionHistory <.. addTags : <<extends>>
viewTransactionHistory <.. addNotes : <<extends>>

' 泛化关系
Customer <|-- VIPCustomer
note right of Customer
  泛化关系:普通客户 <|-- VIP客户
end note

' 用例说明注释
note right of vipManagement
  系统根据消费总额自动评定VIP等级
  商家可设置不同等级客户的专属权益
  支持批量发放优惠券
end note

note right of viewTransactionHistory
  支持按时间段、商品类别筛选\n
  支持导出为CSV格式
end note

@enduml